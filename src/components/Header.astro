---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Monogram from '../assets/logo/monogram.svg';
import { dict, sections, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { nav } = dict[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-ink/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6">
    <a href={getRelativeLocaleUrl(lang)} class="flex items-center gap-3">
      <Monogram width={36} height={36} aria-hidden="true" />
      <span class="text-sm font-semibold tracking-[0.3em]">JR STUDIO</span>
    </a>

    <nav aria-label={nav.menu} class="flex items-center gap-6 text-sm">
      <ul class="hidden gap-8 md:flex">
        {sections.map((id) => (
          <li><a href={`#${id}`} class="text-muted transition-colors hover:text-paper">{nav[id]}</a></li>
        ))}
      </ul>

      <details class="group relative md:hidden">
        <summary class="flex size-10 cursor-pointer list-none items-center justify-center text-muted hover:text-paper [&::-webkit-details-marker]:hidden">
          <span class="sr-only">{nav.menu}</span>
          <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path class="group-open:hidden" d="M3 7h18M3 12h18M3 17h18" />
            <path class="hidden group-open:block" d="M5 5l14 14M19 5L5 19" />
          </svg>
        </summary>
        <ul class="absolute right-0 mt-4 w-48 border border-white/10 bg-ink-2 py-2">
          {sections.map((id) => (
            <li><a href={`#${id}`} class="block px-4 py-2 text-muted hover:text-paper">{nav[id]}</a></li>
          ))}
        </ul>
      </details>

      <a
        href={getRelativeLocaleUrl(other)}
        hreflang={other}
        class="border border-white/15 px-2.5 py-1 text-xs tracking-widest text-paper transition-colors hover:border-gold"
      >
        {other.toUpperCase()}<span class="sr-only"> — {nav.switchLangLabel}</span>
      </a>
    </nav>
  </div>
</header>

<script>
  // Close the mobile menu after jumping to a section.
  document.querySelectorAll('header details a').forEach((a) =>
    a.addEventListener('click', () => a.closest('details')?.removeAttribute('open')),
  );
</script>
