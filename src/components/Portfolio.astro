---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from './Section.astro';
import { dict, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { portfolio } = dict[lang];
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Section id="portfolio" index="02" title={portfolio.title} intro={portfolio.intro}>
  <ul class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map(({ data }) => {
      const Tag = data.url ? 'a' : 'div';
      return (
        <li>
          <Tag href={data.url} class="group block">
            <div class="overflow-hidden border border-white/10 transition-colors group-hover:border-gold">
              <Image
                src={data.cover}
                alt={data.alt[lang]}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <div class="mt-5 flex items-baseline justify-between gap-4">
              <h3 class="text-lg font-medium">{data.title}</h3>
              <span class="text-sm text-muted">{data.year}</span>
            </div>
            <p class="mt-1 text-xs uppercase tracking-[0.25em] text-gold">{portfolio.categories[data.category]}</p>
            <p class="mt-3 text-sm text-muted">{data.summary[lang]}</p>
          </Tag>
        </li>
      );
    })}
  </ul>
</Section>
