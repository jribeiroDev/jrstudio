---
import { dict, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { hero } = dict[Astro.props.lang];
---

<section class="mx-auto max-w-6xl px-4 pt-20 pb-28 sm:px-6 md:pt-36 md:pb-44">
  <p class="text-sm uppercase tracking-[0.3em] text-gold">{hero.eyebrow}</p>
  <h1 class="mt-6 max-w-4xl text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl md:text-7xl">
    {hero.title}
  </h1>
  <p class="mt-8 max-w-2xl text-lg text-muted">{hero.subtitle}</p>
  <a
    href="#portfolio"
    class="mt-12 inline-flex items-center gap-3 border border-gold px-6 py-3 text-sm tracking-wide transition-colors hover:bg-gold hover:text-ink"
  >
    {hero.cta} <span aria-hidden="true">→</span>
  </a>
</section>
