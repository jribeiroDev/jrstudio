---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { dict, htmlLang, ogLocale, type Lang } from '../i18n/utils';
import { SITE } from '../site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { meta } = dict[lang];
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = { pt: new URL('/', site).href, en: new URL('/en/', site).href };
const ogImage = new URL('/og-image.png', site).href;
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site.href}#organization`,
      name: SITE.name,
      url: site.href,
      logo: new URL('/apple-touch-icon.png', site).href,
      image: ogImage,
      email: SITE.email,
      description: meta.description,
      areaServed: SITE.areaServed,
      sameAs: SITE.socials.map((s) => s.url),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: SITE.name,
      inLanguage: ['pt-PT', 'en'],
      publisher: { '@id': `${site.href}#organization` },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-PT" href={alternates.pt} />
    <link rel="alternate" hreflang="en" href={alternates.en} />
    <link rel="alternate" hreflang="x-default" href={alternates.pt} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0E0E10" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-manrope" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-outfit" preload />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
